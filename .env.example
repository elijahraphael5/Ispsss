# --- Core ---
NODE_ENV=development
APP_PORT=4000
APP_URL=http://localhost:4000

# Comma-separated browser origins allowed by CORS on the gateway + all services
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Gateway throttling (Nest ThrottlerModule)
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=100

# Runs the dev-only fake data job (api). Keep unset/off in production.
ENABLE_DATA_SIMULATOR=false

# --- Database ---
DATABASE_URL=postgresql://isp_user:change_me@localhost:5432/isp_platform?schema=public
DATABASE_REPLICA_URL=

# --- Redis ---
REDIS_URL=redis://localhost:6379

# --- Auth ---
JWT_ACCESS_SECRET=change_me
JWT_REFRESH_SECRET=change_me
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
TWO_FA_ISSUER=Hikonnect

# --- Object Storage (S3-compatible / MinIO) ---
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=isp-platform
S3_ACCESS_KEY=change_me
S3_SECRET_KEY=change_me

# --- Payments (Nigeria) ---
WEBHOOK_SERVICE_TOKEN=change_me
PAYSTACK_SECRET_KEY=
FLUTTERWAVE_SECRET_KEY=
MONNIFY_API_KEY=
MONNIFY_SECRET_KEY=
REMITA_MERCHANT_ID=

# --- Messaging ---
SMS_PROVIDER_API_KEY=
WHATSAPP_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# --- Network Integration ---
MIKROTIK_API_HOST=
MIKROTIK_API_USER=
MIKROTIK_API_PASS=

# --- Monitoring ---
SENTRY_DSN=

# --- RADIUS (Phase 2: FreeRADIUS + radius-service) ---
RADIUS_SERVICE_URL=http://localhost:4106
RADIUS_DB_HOST=localhost
RADIUS_DB_PORT=3306
RADIUS_DB_USER=radius
RADIUS_DB_PASSWORD=radiuspw
RADIUS_DB_NAME=radius
# NAS (MikroTik) target for CoA/disconnect — colima/lima host gateway by default
RADIUS_NAS_IP=192.168.5.2
RADIUS_NAS_PORT=3799
RADIUS_SHARED_SECRET=testing123
# Password written to radcheck on first activation (customer-facing)
RADIUS_DEFAULT_PASSWORD=ChangeMe1!
# Shared token for internal billing/payments -> radius webhooks
WEBHOOK_SERVICE_TOKEN=

# --- Frontend deployment (docker compose) ---
# Paystack public key (baked into the customer build; live pk_live_... in production)
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=
# Base URL of the customer portal (Paystack redirects back to <CUSTOMER_URL>/payment/callback)
CUSTOMER_URL=https://my.hikonnectng.com
# Hostnames for the nginx reverse proxy (must point at the host)
NGINX_ADMIN_HOST=admin.hikonnectng.com
NGINX_CUSTOMER_HOST=my.hikonnectng.com
NGINX_API_HOST=api.hikonnectng.com
# Comma-separated origins allowed by the backend CORS policy
CORS_ORIGINS=https://admin.hikonnectng.com,https://my.hikonnectng.com
