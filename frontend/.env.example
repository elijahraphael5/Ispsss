# --- Core ---
NODE_ENV=development
APP_PORT=4000
APP_URL=http://localhost:4000

# --- Database ---
DATABASE_URL=postgresql://isp_user:change_me@localhost:5432/isp_platform?schema=public
DATABASE_REPLICA_URL=

# --- Redis ---
REDIS_URL=redis://localhost:6379

# --- Auth ---
JWT_ACCESS_SECRET=change_me
JWT_REFRESH_SECRET=change_me
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
TWO_FA_ISSUER=Hikonnect

# --- Object Storage (S3-compatible / MinIO) ---
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=isp-platform
S3_ACCESS_KEY=change_me
S3_SECRET_KEY=change_me

# --- Payments (Nigeria) ---
PAYSTACK_SECRET_KEY=
FLUTTERWAVE_SECRET_KEY=
MONNIFY_API_KEY=
MONNIFY_SECRET_KEY=
REMITA_MERCHANT_ID=

# --- Messaging ---
SMS_PROVIDER_API_KEY=
WHATSAPP_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# --- Network Integration ---
MIKROTIK_API_HOST=
MIKROTIK_API_USER=
MIKROTIK_API_PASS=

# --- Monitoring ---
SENTRY_DSN=
